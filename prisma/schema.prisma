generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared Kernel — src/core/
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                String   @unique @db.VarChar(63)
  name                String   @db.VarChar(120)
  timezone            String   @db.VarChar(50)
  currency            String   @default("ARS") @db.VarChar(3)
  isActive            Boolean  @default(true) @map("is_active")
  clerkOrganizationId String?  @unique @map("clerk_organization_id") @db.VarChar(255)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  branches            Branch[]
  memberships         Membership[]
  membershipInvites   MembershipInvite[]
  professionals       Professional[]
  services            Service[]
  weeklySchedules     WeeklySchedule[]
  calendarExceptions  CalendarException[]
  calendarBlocks      CalendarBlock[]
  clients             Client[]
  appointments        Appointment[]

  @@map("tenants")
}

model Branch {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String  @db.VarChar(120)
  address  String? @db.VarChar(255)
  phone    String? @db.VarChar(20)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionals Professional[]
  appointments Appointment[]
  schedules    WeeklySchedule[]
  exceptions   CalendarException[]
  blocks       CalendarBlock[]

  @@unique([tenantId, id])
  @@map("branches")
}

model User {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalId String  @unique @map("external_id") @db.VarChar(255)
  email      String  @unique @db.VarChar(320)
  firstName  String? @map("first_name") @db.VarChar(100)
  lastName   String? @map("last_name") @db.VarChar(100)
  avatarUrl  String? @map("avatar_url") @db.VarChar(2048)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  memberships       Membership[]
  membershipInvites MembershipInvite[] @relation("MembershipInviteInviter")

  @@map("users")
}

enum MembershipRole {
  OWNER
  ADMIN
  PROFESSIONAL
  RECEPTION

  @@map("membership_role")
}

enum MembershipInviteStatus {
  PENDING
  ACCEPTED
  REVOKED

  @@map("membership_invite_status")
}

model Membership {
  id       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String         @map("tenant_id") @db.Uuid
  userId   String         @map("user_id") @db.Uuid
  role     MembershipRole
  isActive Boolean        @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  professional Professional? @relation("MembershipProfessional")

  @@unique([tenantId, userId])
  @@map("memberships")
}

model MembershipInvite {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  email             String                 @db.VarChar(320)
  role              MembershipRole
  status            MembershipInviteStatus @default(PENDING)
  clerkInvitationId String?                @unique @map("clerk_invitation_id") @db.VarChar(255)
  invitedByUserId   String                 @map("invited_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("MembershipInviteInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  // Unicidad de (tenant, email) PENDING se garantiza en el caso de uso; Prisma no expresa unique parcial.
  @@index([tenantId, email, status])
  @@map("membership_invites")
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenant Configuration — modules/tenant-config
// ─────────────────────────────────────────────────────────────────────────────

model Professional {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  branchId     String  @map("branch_id") @db.Uuid
  membershipId String? @unique @map("membership_id") @db.Uuid
  displayName  String  @map("display_name") @db.VarChar(120)
  color        String? @db.VarChar(7)
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch     Branch      @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  membership Membership? @relation("MembershipProfessional", fields: [membershipId], references: [id], onDelete: SetNull)

  services     ProfessionalService[]
  schedules    WeeklySchedule[]
  exceptions   CalendarException[]
  blocks       CalendarBlock[]
  appointments Appointment[]

  @@unique([tenantId, id])
  @@index([tenantId, branchId])
  @@map("professionals")
}

model Service {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  name            String  @db.VarChar(120)
  durationMinutes Int     @map("duration_minutes")
  priceAmount     Int     @map("price_amount")
  prepMinutes     Int     @default(0) @map("prep_minutes")
  cleanupMinutes  Int     @default(0) @map("cleanup_minutes")
  earliestStart   String? @map("earliest_start") @db.VarChar(5)
  latestStart     String? @map("latest_start") @db.VarChar(5)
  requiresDeposit Boolean @default(false) @map("requires_deposit")
  isActive        Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionals       ProfessionalService[]
  appointmentServices AppointmentService[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("services")
}

model ProfessionalService {
  tenantId       String @map("tenant_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid
  serviceId      String @map("service_id") @db.Uuid

  professional Professional @relation(fields: [tenantId, professionalId], references: [tenantId, id], onDelete: Cascade)
  service      Service      @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@index([tenantId])
  @@map("professional_services")
}

// ─────────────────────────────────────────────────────────────────────────────
// Schedules & Calendar — modules/tenant-config
// ─────────────────────────────────────────────────────────────────────────────

model WeeklySchedule {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  branchId       String? @map("branch_id") @db.Uuid
  professionalId String? @map("professional_id") @db.Uuid
  dayOfWeek      Int     @map("day_of_week") @db.SmallInt // 0 = domingo … 6 = sábado
  startTime      String  @map("start_time") @db.VarChar(5)
  endTime        String  @map("end_time") @db.VarChar(5)
  capacity       Int     @default(1)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  professional Professional? @relation(fields: [tenantId, professionalId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, professionalId])
  @@index([tenantId, branchId])
  @@map("weekly_schedules")
}

model CalendarException {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  branchId       String? @map("branch_id") @db.Uuid
  professionalId String? @map("professional_id") @db.Uuid
  date           String  @db.VarChar(10)
  startTime      String? @map("start_time") @db.VarChar(5)
  endTime        String? @map("end_time") @db.VarChar(5)
  reason         String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  professional Professional? @relation(fields: [tenantId, professionalId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, professionalId, date])
  @@index([tenantId, branchId, date])
  @@map("calendar_exceptions")
}

model CalendarBlock {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  branchId       String? @map("branch_id") @db.Uuid
  professionalId String? @map("professional_id") @db.Uuid
  startDate      String  @map("start_date") @db.VarChar(10)
  endDate        String  @map("end_date") @db.VarChar(10)
  startTime      String? @map("start_time") @db.VarChar(5)
  endTime        String? @map("end_time") @db.VarChar(5)
  reason         String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  professional Professional? @relation(fields: [tenantId, professionalId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, professionalId, startDate, endDate])
  @@index([tenantId, branchId, startDate, endDate])
  @@map("calendar_blocks")
}

// ─────────────────────────────────────────────────────────────────────────────
// Clients — modules/clients
// ─────────────────────────────────────────────────────────────────────────────

model Client {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  phone       String  @db.VarChar(20)
  firstName   String? @map("first_name") @db.VarChar(100)
  lastName    String? @map("last_name") @db.VarChar(100)
  email       String? @db.VarChar(320)
  notes       String? @db.Text
  whatsappOptIn Boolean @default(true) @map("whatsapp_opt_in")
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([tenantId, id])
  @@unique([tenantId, phone])
  @@map("clients")
}

// ─────────────────────────────────────────────────────────────────────────────
// Booking — modules/booking
// ─────────────────────────────────────────────────────────────────────────────

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("appointment_status")
}

enum AppointmentOrigin {
  PANEL
  PUBLIC

  @@map("appointment_origin")
}

model Appointment {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  branchId       String            @map("branch_id") @db.Uuid
  professionalId String            @map("professional_id") @db.Uuid
  clientId       String            @map("client_id") @db.Uuid
  status         AppointmentStatus @default(PENDING)
  origin         AppointmentOrigin

  // ADR-005: hora local + zona horaria + instante UTC derivado
  localDate    String   @map("local_date") @db.VarChar(10)
  localTime    String   @map("local_time") @db.VarChar(5)
  timezone     String   @db.VarChar(50)
  startsAt     DateTime @map("starts_at") @db.Timestamptz
  endsAt       DateTime @map("ends_at") @db.Timestamptz
  durationMinutes Int   @map("duration_minutes")

  cancelledBy  String?  @map("cancelled_by") @db.VarChar(10)
  cancelReason String?  @map("cancel_reason") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  professional Professional @relation(fields: [tenantId, professionalId], references: [tenantId, id], onDelete: Cascade)
  client       Client       @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Cascade)

  services AppointmentService[]

  // Consulta principal: agenda de un profesional en un día
  @@index([tenantId, professionalId, localDate])
  // Vista mes del tenant (todos los profesionales)
  @@index([tenantId, localDate])
  // Consulta por sucursal
  @@index([tenantId, branchId, localDate])
  // Consulta por rango UTC (notificaciones, reportes)
  @@index([tenantId, startsAt])
  // Consulta por cliente
  @@index([tenantId, clientId])
  @@unique([tenantId, id])
  @@map("appointments")
}

model AppointmentService {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  appointmentId String @map("appointment_id") @db.Uuid
  serviceId     String @map("service_id") @db.Uuid

  // Snapshot al momento de reservar (19-domain-model.md §4)
  serviceName     String @map("service_name") @db.VarChar(120)
  durationMinutes Int    @map("duration_minutes")
  priceAmount     Int    @map("price_amount")

  appointment Appointment @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Cascade)
  service     Service     @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId])
  @@map("appointment_services")
}
