# Plantilla de variables de entorno.
#
# Copiar como .env.local y completar los valores. Ningún archivo .env se versiona
# salvo esta plantilla. El inventario completo de variables, dónde se almacenan y
# cómo se rotan es competencia de docs/12-deployment.md §2.

# URL pública de la aplicación. Se usa para construir enlaces absolutos, por
# ejemplo los de recordatorios y los metadatos para compartir.
NEXT_PUBLIC_APP_URL=http://localhost:9700

# PostgreSQL — conexión de la aplicación (ADR-022).
# Rol saas_app, sin BYPASSRLS. En producción pasa por el pooler.
# Neon y otros hosts con TLS suelen traer sslmode=require; la app lo normaliza a
# verify-full para no disparar el aviso de `pg` que Next muestra como error.
DATABASE_URL=postgresql://saas_app:password@localhost:5432/saas_turnos?schema=public

# PostgreSQL — rol dueño de las tablas. Solo migraciones (`pnpm db:migrate`) y
# seed (`pnpm db:seed`). La aplicación no la lee. Mientras no exista saas_app,
# puede ser la misma URL que DATABASE_URL.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/saas_turnos?schema=public

# Rama de Neon solo para pruebas (`pnpm test:db`). No es la base de la app.
# TEST_DATABASE_URL es el rol saas_app de esa rama.
# TEST_DIRECT_URL es el rol dueño de la misma rama y siembra los dos negocios.
# TEST_DATABASE_URL=
# TEST_DIRECT_URL=

# Clerk — proveedor de identidad. Las claves se obtienen desde
# https://dashboard.clerk.com → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk — rutas de autenticación
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Solo desarrollo — ID del usuario de Clerk para el seed script.
# Buscalo en https://dashboard.clerk.com → Users → tu usuario → User ID.
# Esa cuenta queda OWNER de Peluquería Demo. Una cuenta distinta no entra al panel.
CLERK_DEV_USER_ID=user_...

# Checklist Clerk Dashboard (no son variables; hay que hacerlo una vez):
# 1. Organizations habilitadas (Configure → Organizations).
# 2. Webhook en /api/webhooks/clerk con estos eventos:
#    - user.created, user.updated, user.deleted
#    - organizationInvitation.accepted
#    - organizationMembership.created
# 3. Tras cambiar eventos, volver a copiar el signing secret a CLERK_WEBHOOK_SECRET.
